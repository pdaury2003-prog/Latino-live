{
  "name": "@latino/games-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Salas de juego de Latino Live: WebSockets y apuestas autoritativas.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
