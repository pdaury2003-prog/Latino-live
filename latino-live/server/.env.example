# Copia este archivo como .env solo en el equipo donde corre el servidor.
# En ExaSpark las llaves se guardan en Cloud -> Keys, nunca en el proyecto.
PORT=8787
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Orígenes permitidos, separados por coma. Vacío acepta cualquier origen.
ALLOWED_ORIGINS=
